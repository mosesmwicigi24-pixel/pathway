# Production env template — copy to `.env` ON THE VPS (next to docker-compose.prod.yml)
# and fill in real values. NEVER commit the real .env (§5.10).
#
#   cp .env.prod.example .env && nano .env
#
# docker-compose.prod.yml interpolates these.

# Public domain that Caddy serves + gets a TLS cert for. DNS A record -> VPS IP.
DOMAIN=api.example.com

# Postgres password (also used in DATABASE_URL and pgbouncer). Use a strong value.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# JWT signing key (§5.5). Generate: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret

# Backend image to run. The CI deploy step overrides this with the exact commit
# SHA tag for an immutable, rollback-able deploy. The default here (latest) is a
# convenience for manual `docker compose` commands.
BACKEND_IMAGE=ghcr.io/mosesmwicigi24-pixel/pathway-backend:latest
