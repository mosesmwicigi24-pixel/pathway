# Production .env template for the Hostinger VPS deploy
# (docker-compose.prod.yml + docker-compose.vps.yml). Copy to /opt/pathway/.env
# on the VPS and fill in real values. NEVER commit the real .env (§5.10) — it is
# git-ignored and lives ONLY on the server. Secrets are referenced by name here.
#
# Compose interpolates these into the stack at `up` time. The variables below are
# the ones the two compose files reference via ${VAR}; the backend also reads the
# usual app secrets (Stripe / M-Pesa / PayPal / KingsChat / OAuth / certs / push)
# from this same file — see .env.example for the full application list.

# --- Database / auth (docker-compose.prod.yml) ---
POSTGRES_PASSWORD=          # openssl rand -hex 32; postgres + the API DATABASE_URL both use it
JWT_SIGNING_KEY=            # openssl rand -base64 48

# --- Image + domain ---
BACKEND_IMAGE=pathway-backend:local   # locally-built image tag (or a GHCR ref)
DOMAIN=pathway.nuruplace.org          # used only by the prod Caddy service (not started on this box)
APP_PUBLIC_URL=https://pathway.nuruplace.org   # base URL in transactional emails

# --- Transactional email via Brevo (docker-compose.vps.yml) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_SERVERNAME=        # left blank for Brevo
SMTP_USER=                  # Brevo SMTP login
SMTP_PASS=                  # Brevo SMTP key
EMAIL_FROM=no-reply@nuruplace.org

# --- Nuru AI (Claude primary; Groq/Gemini fallback if the key is missing or
# rate-limited — buildAiProvider() degrades to a real model, never to canned
# text) + uploads ---
ANTHROPIC_API_KEY=          # console.anthropic.com — primary provider, required for real AI output
ANTHROPIC_MODEL=claude-sonnet-5        # standard tier (interactive/on-demand generation)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001   # fast tier (high-volume classification/batch)
ANTHROPIC_MODEL_DEEP=claude-opus-5     # deep tier (Sunday Letter, Flock Brief, daily liturgy)
GROQ_API_KEY=                # fallback only
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=               # fallback only
CLOUDINARY_URL=             # cloudinary://<key>:<secret>@<cloud>

# --- nuruplace.org intakes (docker-compose.vps.yml) ---
# The church website posts two kinds of signed payload here: enquiries from the
# connection card / contact form / prayer request (migration 201), and gifts
# (migration 202). Both are authenticated by an HMAC over the raw body — there
# is no session to authenticate with — so each secret must EQUAL its
# counterpart in /srv/nuruplace/.env:
#
#     WEBSITE_CONTACT_WEBHOOK_SECRET  ==  CONTACT_WEBHOOK_SECRET   (website)
#     WEBSITE_GIVING_WEBHOOK_SECRET   ==  PATHWAY_GIVING_SECRET    (website)
#
# Unset or blank means the matching endpoint refuses EVERY request with 503, on
# purpose: an unauthenticated write into the pastoral inbox, or an open endpoint
# that sends M-Pesa payment requests to any number typed into it, is worse than
# a website that tells visitors to telephone. The website handles that refusal
# gracefully at both ends.
WEBSITE_CONTACT_WEBHOOK_SECRET=   # openssl rand -hex 32
WEBSITE_GIVING_WEBHOOK_SECRET=    # openssl rand -hex 32

# --- Africa's Talking SMS (docker-compose.vps.yml, api AND worker) ---
# The thank-you a website giver can actually receive. Every notifications row is
# keyed to a user_id and a website giver has no account, so before this they got
# Safaricom's own SMS and nothing from the church at all. The WORKER sends it —
# it drains the outbox — so these must reach the worker, not only the api.
#
# Unset → no provider is bound and the worker logs a warning rather than
# pretending a receipt was sent. Every message costs the church airtime.
#
# AFRICASTALKING_ENV picks the HOST, not a flag: sandbox is a different domain
# and delivers to nobody, so leaving it at the default in production means every
# giver is silently unthanked.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=          # your Africa's Talking username (NOT 'sandbox' in production)
AFRICASTALKING_SENDER_ID=         # the registered shortcode; blank uses their shared pool
AFRICASTALKING_ENV=sandbox        # `production` once the shortcode is live

# --- M-Pesa Daraja / STK push (docker-compose.vps.yml) ---
# Website giving needs these as well as the secret above. GET /v1/giving/funds
# reports mpesa `enabled: false` without them, and nuruplace.org/give then shows
# its "not switched on yet" panel rather than a form that cannot work. The
# provider counts as ready only when key + secret + passkey + shortcode +
# callback URL are ALL set.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox           # `production` once Safaricom has approved the shortcode
MPESA_TX_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://pathway.nuruplace.org/v1/webhooks/mobilemoney/mpesa
